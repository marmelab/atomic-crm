# Copy this file to .env.development (for local dev against a real
# Supabase project) or .env.production.local (for a deployed frontend) and
# fill in real values. See doc/src/content/docs/developers/
# supabase-configuration.mdx for the full setup guide. Never commit a file
# with real values — only .env.example itself is meant to be checked in.

SKIP_PREFLIGHT_CHECK=true

# Your Supabase project's API URL and publishable (anon) key. Both are
# safe to expose in the client bundle by design — Postgres RLS is the
# actual access boundary, not these values. Use
# http://127.0.0.1:54321 / the local dev key already in .env.development
# for local development against `supabase start`.
VITE_SUPABASE_URL=
VITE_SB_PUBLISHABLE_KEY=

# Set to "true" to run the FakeRest demo data provider instead of a real
# Supabase backend — no server needed at all.
VITE_IS_DEMO=false

# Inbound email address configured in Postmark (see the inbound-email-
# configuration guide) — leave unset if you aren't using that feature.
VITE_INBOUND_EMAIL=

VITE_ATTACHMENTS_BUCKET=attachments

# -------------------------------------------------------------------------
# Server-side only — Supabase Edge Function secrets. These are NOT Vite
# vars (no VITE_ prefix — they must never end up in the client bundle) and
# they do not belong in this file, .env.development, or any other tracked
# .env* — they are real third-party credentials, not local app config.
#
# For a DEPLOYED project, set them with:
#   npx supabase secrets set ACUITY_USER_ID=... ACUITY_API_KEY=...
#
# For LOCAL `supabase functions serve` testing, put them in a personal
# supabase/functions/.env.local (gitignored — the repo's own
# supabase/functions/.env stays real-secret-free, shared, and committed)
# and run:
#   npx supabase functions serve --env-file supabase/functions/.env.local
# -------------------------------------------------------------------------

# Acuity Scheduling integration (Live Acuity Connection slice). Both values
# are shown together on the same page in Acuity: Business Settings ->
# Integrations -> API — ACUITY_API_KEY is the "API Key" shown there,
# ACUITY_USER_ID is the numeric "User ID" just above it. Used for:
#  (1) Basic Auth on the authenticated GET /appointments/:id call every
#      webhook triggers (a real Acuity webhook never carries appointment
#      details itself — see supabase/functions/acuity_webhook/acuityApi.ts).
#  (2) Verifying the `x-acuity-signature` header Acuity signs every webhook
#      POST with (HMAC-SHA256 of the raw body, using this same API key as
#      the secret — see supabase/functions/acuity_webhook/acuitySignature.ts).
ACUITY_USER_ID=
ACUITY_API_KEY=
