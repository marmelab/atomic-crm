# Backend (Turso / libSQL) configuration — copy to .env and fill in.
#
# Remote Turso database (production / VPS):
#   turso db create atomic-crm
#   turso db show atomic-crm --url          -> TURSO_DATABASE_URL
#   turso db tokens create atomic-crm       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# For a purely local database instead of Turso, use a file URL and no token:
#   TURSO_DATABASE_URL=file:./db/atomic-crm.local.db

# Backend HTTP port (the Vite dev server proxies /api to this port)
PORT=3001
