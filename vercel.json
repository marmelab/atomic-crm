{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/apply", "destination": "/#/apply", "permanent": false },
    {
      "source": "/apply/:path*",
      "destination": "/#/apply/:path*",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
